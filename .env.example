APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1

POSTGRES_DB=hydrosentinel
POSTGRES_USER=hydrosentinel
POSTGRES_PASSWORD=hydrosentinel
DATABASE_URL=postgresql+psycopg://hydrosentinel:hydrosentinel@postgres:5432/hydrosentinel

JWT_SECRET_KEY=replace-with-local-development-secret-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=optional-admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=optional-local-admin-password-not-for-production
BOOTSTRAP_ADMIN_NAME=HydroSentinel Admin
ALLOW_PUBLIC_REGISTRATION=false
TRUST_PROXY_HEADERS=false

FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
